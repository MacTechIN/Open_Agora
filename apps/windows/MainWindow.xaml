<Window
    x:Class="CivicAgora.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="CivicAgora — 시민 공론장">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── 머리말 ────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Padding="28,20,28,14" Spacing="10"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="CivicAgora" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="정책을 함께 검증하는 시민 공론장" VerticalAlignment="Bottom"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="PlazaButton" Content="광장" Click="OnGoPlaza" />
                <Button x:Name="NewTopicButton" Content="주제 올리기" Click="OnGoNewTopic" />
                <Button x:Name="MemberButton" Content="시민 인증" Click="OnGoMember" />
                <Button x:Name="RefreshButton" Content="새로고침" Click="OnRefresh" />
            </StackPanel>

            <InfoBar x:Name="Notice" IsOpen="False" IsClosable="True" />
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" />
        </StackPanel>

        <!-- ── 본문: 한 번에 하나만 보인다 ──────────────────────────
             Frame 내비게이션 대신 보임/숨김으로 전환한다. 화면이 넷뿐이고,
             상태를 창이 들고 있어 페이지 간 전달이 필요 없다. -->
        <ScrollViewer Grid.Row="1">
            <Grid Padding="28,18,28,40">

                <!-- 광장 ────────────────────────────────────────────
                     주제가 수백 개가 되면 문제는 스크롤 길이가 아니라
                     "무엇을 봐야 할지 모른다"는 것이다. 웹과 같은 수단을 둔다. -->
                <StackPanel x:Name="PlazaView" Spacing="12" MaxWidth="1000" HorizontalAlignment="Left">
                    <TextBlock x:Name="PlazaHeader" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="SearchBox" Width="360"
                                 PlaceholderText="주제·쟁점 질문·기관 검색" />
                        <Button Content="검색" Click="OnSearch" />
                        <Button Content="지우기" Click="OnClearSearch" />
                    </StackPanel>

                    <!-- 분류 칩. 개수를 함께 보여 어디에 무엇이 있는지 알린다.
                         WrapPanel 은 WinUI 3 기본에 없어 CommunityToolkit 이
                         필요하다. 의존성을 늘리지 않고 가로 스크롤로 둔다. -->
                    <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CategoryChips" Orientation="Horizontal" Spacing="6" />
                    </ScrollViewer>

                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="정렬" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <ComboBox x:Name="SortBox" SelectedIndex="0" MinWidth="140"
                                      SelectionChanged="OnSortOrViewChanged" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="보기" VerticalAlignment="Center"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <ComboBox x:Name="ViewBox" SelectedIndex="0" MinWidth="110"
                                      SelectionChanged="OnSortOrViewChanged" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock x:Name="SortHint" TextWrapping="Wrap" Visibility="Collapsed"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <StackPanel x:Name="PolicyList" Spacing="8" />
                </StackPanel>

                <!-- 주제 상세 -->
                <StackPanel x:Name="DetailView" Spacing="14" Visibility="Collapsed" MaxWidth="1100">
                    <HyperlinkButton Content="← 광장으로" Click="OnGoPlaza" Padding="0" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="DetailTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailMeta" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel>
                                <TextBlock Text="쟁점 질문" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="DetailQuestion" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="왜 지금 이슈인가" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock x:Name="DetailBackground" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3열. 좌우 폭이 같아야 한다 — 어느 쪽도 우대하지 않는다. -->
                    <TextBlock x:Name="OpinionHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="SupportColumn" Grid.Column="0" Spacing="8" />
                        <StackPanel x:Name="AlternativeColumn" Grid.Column="1" Spacing="8" />
                        <StackPanel x:Name="OpposeColumn" Grid.Column="2" Spacing="8" />
                    </Grid>

                    <!-- 의견 쓰기 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                        <StackPanel Spacing="14">
                            <TextBlock Text="내 의견 남기기" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="OpinionQuestion" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ContentControl x:Name="OpinionFormHost" HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 주제 올리기 -->
                <StackPanel x:Name="NewTopicView" Spacing="14" Visibility="Collapsed" MaxWidth="820">
                    <HyperlinkButton Content="← 광장으로" Click="OnGoPlaza" Padding="0" />
                    <TextBlock Text="주제 올리기" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="무엇을 공론화하려 하시나요?" Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="주제 제목" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Name="TitleCount" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                                <TextBox x:Name="TitleBox" PlaceholderText="예) 탄력 근로제 직종별 차등 적용" />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="분류" Style="{StaticResource CaptionTextBlockStyle}" />
                                <ComboBox x:Name="CategoryBox" HorizontalAlignment="Stretch" SelectedIndex="0" />
                            </StackPanel>

                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="왜 지금 이슈인가요?" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Name="BackgroundCount" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                                <TextBox x:Name="BackgroundBox" TextWrapping="Wrap" AcceptsReturn="True" Height="76"
                                         PlaceholderText="예) 최근 개정안이 발의되면서 업종별 적용 기준을 두고 노사 간 이견이 커지고 있습니다." />
                            </StackPanel>

                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="쟁점 질문" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Name="QuestionCount" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Grid>
                                <TextBox x:Name="QuestionBox" PlaceholderText="예) 직종별로 탄력 근로제 적용 기준을 달리해야 하는가?" />
                                <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="찬성과 반대가 갈릴 수 있는 하나의 질문으로 적어주세요. 이 질문이 토론의 축이 됩니다." />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="공식 출처 링크" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBox x:Name="SourceBox" PlaceholderText="https://likms.assembly.go.kr/..." />
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="소관 기관 (선택)" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBox x:Name="AgencyBox" PlaceholderText="예) 고용노동부" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock Text="이 질문에 대한 내 입장" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="주제를 여는 분도 자기 의견을 함께 남깁니다. 토론이 빈 상태로 시작하지 않도록 하기 위해서입니다." />
                            <ContentControl x:Name="NewTopicFormHost" HorizontalContentAlignment="Stretch" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 시민 인증 -->
                <StackPanel x:Name="MemberView" Spacing="14" Visibility="Collapsed" MaxWidth="560">
                    <HyperlinkButton Content="← 광장으로" Click="OnGoPlaza" Padding="0" />
                    <TextBlock Text="시민 인증" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="14">
                            <TextBlock TextWrapping="Wrap"
                                       Text="글을 쓰려면 이메일 인증이 한 번 필요합니다. 한 이메일로 한 사람만 가입할 수 있습니다." />
                            <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="인증이 끝나면 회원 자격만 남습니다. 어떤 글이 누구의 것인지는 저장하지 않습니다." />

                            <StackPanel>
                                <TextBlock Text="이메일" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBox x:Name="EmailBox" PlaceholderText="name@example.com" />
                            </StackPanel>
                            <Button x:Name="RequestCodeButton" Content="인증코드 받기" Click="OnRequestCode" />

                            <StackPanel x:Name="CodePanel" Spacing="10" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="인증코드 (6자리)" Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBox x:Name="CodeBox" MaxLength="6" PlaceholderText="000000" />
                                </StackPanel>
                                <Button x:Name="VerifyButton" Content="인증 완료하기" Click="OnVerify"
                                        Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>

                            <TextBlock x:Name="MemberStatus" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Expander Header="내 시민 ID" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Spacing="8" Padding="0,8,0,4">
                            <TextBlock x:Name="DidText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                       FontFamily="Consolas" FontSize="12" />
                            <TextBlock x:Name="ProtectionText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" />
                            <TextBlock x:Name="CoreText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
