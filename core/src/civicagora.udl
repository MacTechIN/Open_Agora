// CivicAgora 코어 인터페이스 — 단일 정의 파일
//
// 이 파일이 Kotlin(Android)·C#(Windows) 바인딩의 유일한 원천이다.
// 손으로 쓴 FFI 래퍼는 금지한다. 두 플랫폼이 어긋나는 가장 흔한 원인이다.
//   → docs/05_CLIENT_APPS.md §1.2, docs/09_DEVELOPMENT_PLAN.md G-PARITY

namespace civicagora {
    // VS-A1: 골격 검증용. 양 플랫폼에서 이 호출이 성공하면 바닥이 뚫린 것이다.
    CoreInfo core_info();

    // VS-A2: 신원.
    //
    // 개인키를 다루는 함수가 없다는 점이 설계다. 키 생성과 서명은 플랫폼의
    // 하드웨어 저장소가 하고, 코어는 공개키만 받는다. 코어가 개인키를 다룰
    // 수 있다면 언젠가 다루게 된다.

    // P-256 공개키(SEC1, 압축/비압축 모두 허용)로 did:key를 만든다.
    [Throws=IdentityError]
    string did_from_public_key(bytes public_key);

    // did:key에서 압축 공개키를 복원한다.
    [Throws=IdentityError]
    bytes public_key_from_did(string did);

    // 서명을 검증한다. 서명은 P1363 형식(r||s, 64바이트).
    [Throws=IdentityError]
    boolean verify_signature(string did, bytes message, bytes signature);

    // VS-A3: 글자 수. 자소 클러스터 기준으로 센다.
    // UI가 남은 글자를 표시할 때 코어와 같은 기준을 쓰도록 노출한다.
    u32 grapheme_count(string text);
};

// ── VS-A3: 토론 카드 ────────────────────────────────────────────────
//
// 삭제와 수정 함수가 없다는 점이 설계다. 카드는 등록 후 지울 수 없고
// 스탠스도 바꿀 수 없다. 대응은 노출 조정 3단계뿐이다 (G-IMMUT).

// 코어 빌드 식별 정보
dictionary CoreInfo {
    // 크레이트 버전 (Cargo.toml)
    string version;

    // 명세 계약 버전. 코어와 앱이 같은 명세를 구현하는지 확인한다.
    // 명세가 바뀌어 호환이 깨지면 이 값을 올린다.
    u32 spec_revision;

    // 빌드 대상 트리플 (예: aarch64-linux-android)
    string target;

    // 디버그 빌드 여부. 릴리스 앱에서 true면 배포 사고다.
    boolean debug;
};

[Error]
interface IdentityError {
    InvalidPublicKey();
    InvalidDid(string reason);
    InvalidSignature();
};

// ── VS-A3′: 안건(주제)과 의견 ──────────────────────────────────────
//
// 삭제와 수정 함수가 없다는 점이 설계다. 등록 후 지울 수 없고 스탠스도
// 바꿀 수 없다. 대응은 노출 조정 3단계뿐이다 (G-IMMUT).

enum StanceType {
    "Support",
    "Alternative",
    "Oppose",
};

enum PolicyCategory {
    "GovPolicy",
    "Legislation",
    "PartyPolicy",
    "Local",
    "PublicOrg",
    "SocialIssue",
    "Whistleblow",
};

// 등록하려는 안건(주제).
//
// core_question이 토론의 축이다. 찬반은 주제가 아니라 이 질문에 대한 것이다.
dictionary DraftPolicy {
    string title;                  // 최대 60자
    PolicyCategory category;
    string background;             // 최대 300자 — 왜 지금 이슈인가
    string core_question;          // 최대 100자 — 찬반이 성립하는 질문
    string official_source_url;
    string? target_agency;
};

dictionary Policy {
    string id;
    string title;
    PolicyCategory category;
    string background;
    string core_question;
    string official_source_url;
    string? target_agency;
    string author_did;
    i64 created_at;
};

// 광장 목록용 요약. 집계를 함께 주어 목록 화면이 N+1 질의를 하지 않게 한다.
dictionary PolicySummary {
    Policy policy;
    u32 support_count;
    u32 alternative_count;
    u32 oppose_count;
    i64 last_activity_at;
};

// 의견. 세 필드의 의미는 논점·근거·제안으로 고정이고,
// 화면에 보이는 질문만 입장에 따라 바뀐다.
dictionary DraftCard {
    StanceType stance;
    string problem_definition;    // 논점, 최대 150자
    string evidence_source;       // 근거, 최대 200자
    string evidence_url;          // 필수, 최대 500자 (글자 수 합계 제외)
    string actionable_solution;   // 제안, 최대 150자
};

dictionary DebateCard {
    string id;
    string policy_id;
    StanceType stance;
    string problem_definition;
    string evidence_source;
    string evidence_url;
    string actionable_solution;
    string author_did;
    i64 created_at;               // epoch 밀리초
};

interface CardStore {
    [Throws=CardError]
    constructor(string path);

    // 안건을 열고 첫 의견을 함께 등록한다. 둘은 한 트랜잭션이다.
    // 주제만 던지고 빠지는 것을 막는다.
    [Throws=CardError]
    string open_policy(DraftPolicy draft, DraftCard first_opinion,
                       string author_did, i64 created_at);

    // 기존 안건에 의견을 추가한다.
    [Throws=CardError]
    string add_opinion(string policy_id, DraftCard draft,
                       string author_did, i64 created_at);

    // 광장 목록. 최근 활동순.
    [Throws=CardError]
    sequence<PolicySummary> list_policies();

    [Throws=CardError]
    Policy? get_policy(string policy_id);

    // 한 안건의 의견 목록. 최신순. 브리징 점수순은 VS-F3에서.
    [Throws=CardError]
    sequence<DebateCard> list_opinions(string policy_id);

    [Throws=CardError]
    u32 count();
};

[Error]
interface CardError {
    Empty(string field);
    TooLong(string field, u32 limit, u32 actual);
    InvalidUrl(string reason);
    Storage(string reason);
};
