// CivicAgora 코어 인터페이스 — 단일 정의 파일
//
// 이 파일이 Kotlin(Android)·C#(Windows) 바인딩의 유일한 원천이다.
// 손으로 쓴 FFI 래퍼는 금지한다. 두 플랫폼이 어긋나는 가장 흔한 원인이다.
//   → docs/05_CLIENT_APPS.md §1.2, docs/09_DEVELOPMENT_PLAN.md G-PARITY

namespace civicagora {
    // VS-A1: 골격 검증용. 양 플랫폼에서 이 호출이 성공하면 바닥이 뚫린 것이다.
    CoreInfo core_info();

    // VS-A2: 신원.
    //
    // 개인키를 다루는 함수가 없다는 점이 설계다. 키 생성과 서명은 플랫폼의
    // 하드웨어 저장소가 하고, 코어는 공개키만 받는다. 코어가 개인키를 다룰
    // 수 있다면 언젠가 다루게 된다.

    // P-256 공개키(SEC1, 압축/비압축 모두 허용)로 did:key를 만든다.
    [Throws=IdentityError]
    string did_from_public_key(bytes public_key);

    // did:key에서 압축 공개키를 복원한다.
    [Throws=IdentityError]
    bytes public_key_from_did(string did);

    // 서명을 검증한다. 서명은 P1363 형식(r||s, 64바이트).
    [Throws=IdentityError]
    boolean verify_signature(string did, bytes message, bytes signature);

    // VS-A3: 글자 수. 자소 클러스터 기준으로 센다.
    // UI가 남은 글자를 표시할 때 코어와 같은 기준을 쓰도록 노출한다.
    u32 grapheme_count(string text);

    // ── 공유 API 코덱 ──────────────────────────────────────────────
    //
    // HTTP 전송은 각 플랫폼이 한다(Android OkHttp, Windows HttpClient).
    // Rust 에 TLS 를 넣으면 크로스 컴파일 위험이 커지고 OS 의 네트워크
    // 정책 통합도 잃는다. 대신 검증과 JSON 모양은 여기서만 만든다 —
    // 두 플랫폼이 각자 조립하면 필드가 어긋나고 서버 로그에서만 보인다.

    // POST /api/policies 본문
    //
    // created_at 을 클라이언트가 정한다. 서명이 시각을 덮으려면 서명하는 쪽이
    // 그 값을 알아야 하기 때문이다. 서버가 정하면 서버가 시각을 바꿔도
    // 검증이 통과한다.
    [Throws=CardError]
    string open_policy_body(DraftPolicy policy, DraftCard first_opinion, string author_did,
                            i64 created_at, bytes policy_signature, bytes opinion_signature);

    // POST /api/policies/{id}/opinions 본문
    [Throws=CardError]
    string add_opinion_body(DraftCard card, string author_did,
                            i64 created_at, bytes signature);

    // ── VS-A4: 작성자 서명 ────────────────────────────────────────
    //
    // 글을 올릴 때 기기 키로 내용에 서명한다. 운영자가 고치면 검증이 깨지므로
    // 고친 사실이 드러난다. 블록체인이 필요 없다 — 이미 있는 것으로 된다.
    //   → docs/16_ONCHAIN_PLAN.md 1단계

    // 서명할 바이트. 플랫폼이 ECDSA(P-256, SHA-256)로 서명한다.
    // 개인키는 코어를 거치지 않는다.
    [Throws=CardError]
    bytes policy_signing_payload(DraftPolicy policy, string author_did, i64 created_at);

    [Throws=CardError]
    bytes opinion_signing_payload(string policy_id, DraftCard card,
                                  string author_did, i64 created_at);

    // 주제 식별자. 첫 의견에 서명하려면 이 값이 필요하다 — 의견 서명이 주제
    // 식별자를 덮어야 같은 서명을 다른 주제에 옮겨 붙일 수 없다.
    [Throws=CardError]
    string policy_id(DraftPolicy policy, string author_did, i64 created_at);

    // 받은 글의 서명을 확인한다. 오류를 던지지 않는 이유는 "서명 없음"과
    // "서명 틀림"이 둘 다 정상적인 결과이기 때문이다.
    SignatureStatus check_policy(Policy policy);
    SignatureStatus check_opinion(DebateCard card);

    // ── VS-F6: 앵커링 ─────────────────────────────────────────────
    //
    // 서명은 고친 글을 드러내지만 지운 글은 드러내지 못한다 — 대조할 대상이
    // 사라지기 때문이다. 일정 시간마다 그 기간의 모든 글을 머클 트리로 묶어
    // 루트 하나만 외부의 바꿀 수 없는 기록에 남긴다.
    //   → docs/16_ONCHAIN_PLAN.md 2단계

    // 잎 해시. 서명과 같은 정규 바이트에서 만든다 — 둘이 다른 것을 가리키면
    // "서명은 맞는데 앵커에는 다른 것이 있다"는 설명할 수 없는 상태가 된다.
    bytes policy_leaf(Policy policy);
    bytes opinion_leaf(DebateCard card);

    // 루트. 잎 순서가 증명의 일부이므로 정렬하지 않는다.
    [Throws=CardError]
    bytes merkle_root(sequence<bytes> leaves);

    [Throws=CardError]
    sequence<MerkleStep> merkle_proof(sequence<bytes> leaves, u32 index);

    // 잎과 증명으로 루트를 다시 만든다. 앵커에 기록된 루트와 대조하는 것은
    // 부르는 쪽의 몫이다 — 여기서 비교까지 하면 무엇과 비교했는지가 숨는다.
    bytes merkle_apply(bytes leaf, sequence<MerkleStep> proof);

    // 등록 응답에서 식별자를 꺼낸다. 서버의 검증 메시지도 오류로 전달한다.
    [Throws=CardError]
    string parse_id(string json);

    // GET /api/policies 응답
    [Throws=CardError]
    sequence<PolicySummary> parse_policies(string json);

    // GET /api/policies/{id} 응답에서 의견 목록
    [Throws=CardError]
    sequence<DebateCard> parse_opinions(string json);
};

// ── VS-A3: 토론 카드 ────────────────────────────────────────────────
//
// 삭제와 수정 함수가 없다는 점이 설계다. 카드는 등록 후 지울 수 없고
// 스탠스도 바꿀 수 없다. 대응은 노출 조정 3단계뿐이다 (G-IMMUT).

// 코어 빌드 식별 정보
dictionary CoreInfo {
    // 크레이트 버전 (Cargo.toml)
    string version;

    // 명세 계약 버전. 코어와 앱이 같은 명세를 구현하는지 확인한다.
    // 명세가 바뀌어 호환이 깨지면 이 값을 올린다.
    u32 spec_revision;

    // 빌드 대상 트리플 (예: aarch64-linux-android)
    string target;

    // 디버그 빌드 여부. 릴리스 앱에서 true면 배포 사고다.
    boolean debug;
};

[Error]
interface IdentityError {
    InvalidPublicKey();
    InvalidDid(string reason);
    InvalidSignature();
};

// ── VS-A3′: 안건(주제)과 의견 ──────────────────────────────────────
//
// 삭제와 수정 함수가 없다는 점이 설계다. 등록 후 지울 수 없고 스탠스도
// 바꿀 수 없다. 대응은 노출 조정 3단계뿐이다 (G-IMMUT).

enum StanceType {
    "Support",
    "Alternative",
    "Oppose",
};

// 머클 증명의 한 걸음.
//
// 형제가 왼쪽인지 오른쪽인지를 함께 담는다. 순서를 잃으면 해시를 어느 쪽으로
// 붙일지 알 수 없고, 그러면 증명이 성립하지 않는다.
dictionary MerkleStep {
    bytes hash;
    boolean sibling_is_left;
};

// 서명 상태.
//
// "없음"과 "틀림"을 구분한다. 서명 이전에 올라온 글은 없는 것이고 그것은
// 위조가 아니다. 둘을 하나로 묶으면 오래된 글이 전부 위조로 보인다.
enum SignatureStatus {
    "Unsigned",
    "Valid",
    "Invalid",
    "Malformed",
};

enum PolicyCategory {
    "GovPolicy",
    "Legislation",
    "PartyPolicy",
    "Local",
    "PublicOrg",
    "SocialIssue",
    "Whistleblow",
};

// 등록하려는 안건(주제).
//
// core_question이 토론의 축이다. 찬반은 주제가 아니라 이 질문에 대한 것이다.
dictionary DraftPolicy {
    string title;                  // 최대 60자
    PolicyCategory category;
    string background;             // 최대 300자 — 왜 지금 이슈인가
    string core_question;          // 최대 100자 — 찬반이 성립하는 질문
    string official_source_url;
    string? target_agency;
};

dictionary Policy {
    string id;
    string title;
    PolicyCategory category;
    string background;
    string core_question;
    string official_source_url;
    string? target_agency;
    string author_did;
    i64 created_at;
    string? signature;            // 작성자 서명(P1363, 16진). 이전 글은 없다
};

// 광장 목록용 요약. 집계를 함께 주어 목록 화면이 N+1 질의를 하지 않게 한다.
dictionary PolicySummary {
    Policy policy;
    u32 support_count;
    u32 alternative_count;
    u32 oppose_count;
    i64 last_activity_at;
};

// 의견. 세 필드의 의미는 논점·근거·제안으로 고정이고,
// 화면에 보이는 질문만 입장에 따라 바뀐다.
dictionary DraftCard {
    StanceType stance;
    string problem_definition;    // 논점, 최대 150자
    string evidence_source;       // 근거, 최대 200자
    string evidence_url;          // 필수, 최대 500자 (글자 수 합계 제외)
    string actionable_solution;   // 제안, 최대 150자
};

dictionary DebateCard {
    string id;
    string policy_id;
    StanceType stance;
    string problem_definition;
    string evidence_source;
    string evidence_url;
    string actionable_solution;
    string author_did;
    i64 created_at;               // epoch 밀리초
    string? signature;            // 작성자 서명(P1363, 16진). 이전 글은 없다
};

interface CardStore {
    [Throws=CardError]
    constructor(string path);

    // 안건을 열고 첫 의견을 함께 등록한다. 둘은 한 트랜잭션이다.
    // 주제만 던지고 빠지는 것을 막는다.
    [Throws=CardError]
    string open_policy(DraftPolicy draft, DraftCard first_opinion,
                       string author_did, i64 created_at,
                       string? policy_signature, string? opinion_signature);

    // 기존 안건에 의견을 추가한다.
    [Throws=CardError]
    string add_opinion(string policy_id, DraftCard draft,
                       string author_did, i64 created_at, string? signature);

    // 광장 목록. 최근 활동순.
    [Throws=CardError]
    sequence<PolicySummary> list_policies();

    [Throws=CardError]
    Policy? get_policy(string policy_id);

    // 한 안건의 의견 목록. 최신순. 브리징 점수순은 VS-F3에서.
    [Throws=CardError]
    sequence<DebateCard> list_opinions(string policy_id);

    [Throws=CardError]
    u32 count();
};

[Error]
interface CardError {
    Empty(string field);
    TooLong(string field, u32 limit, u32 actual);
    InvalidUrl(string reason);
    Storage(string reason);
};
