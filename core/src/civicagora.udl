// CivicAgora 코어 인터페이스 — 단일 정의 파일
//
// 이 파일이 Kotlin(Android)·C#(Windows) 바인딩의 유일한 원천이다.
// 손으로 쓴 FFI 래퍼는 금지한다. 두 플랫폼이 어긋나는 가장 흔한 원인이다.
//   → docs/05_CLIENT_APPS.md §1.2, docs/09_DEVELOPMENT_PLAN.md G-PARITY

namespace civicagora {
    // VS-A1: 골격 검증용. 양 플랫폼에서 이 호출이 성공하면 바닥이 뚫린 것이다.
    CoreInfo core_info();

    // VS-A2: 신원.
    //
    // 개인키를 다루는 함수가 없다는 점이 설계다. 키 생성과 서명은 플랫폼의
    // 하드웨어 저장소가 하고, 코어는 공개키만 받는다. 코어가 개인키를 다룰
    // 수 있다면 언젠가 다루게 된다.

    // P-256 공개키(SEC1, 압축/비압축 모두 허용)로 did:key를 만든다.
    [Throws=IdentityError]
    string did_from_public_key(bytes public_key);

    // did:key에서 압축 공개키를 복원한다.
    [Throws=IdentityError]
    bytes public_key_from_did(string did);

    // 서명을 검증한다. 서명은 P1363 형식(r||s, 64바이트).
    [Throws=IdentityError]
    boolean verify_signature(string did, bytes message, bytes signature);

    // VS-A3: 글자 수. 자소 클러스터 기준으로 센다.
    // UI가 남은 글자를 표시할 때 코어와 같은 기준을 쓰도록 노출한다.
    u32 grapheme_count(string text);
};

// ── VS-A3: 토론 카드 ────────────────────────────────────────────────
//
// 삭제와 수정 함수가 없다는 점이 설계다. 카드는 등록 후 지울 수 없고
// 스탠스도 바꿀 수 없다. 대응은 노출 조정 3단계뿐이다 (G-IMMUT).

enum StanceType {
    "Support",
    "Alternative",
    "Oppose",
};

dictionary DraftCard {
    StanceType stance;
    string problem_definition;    // 최대 150자
    string evidence_source;       // 최대 200자
    string evidence_url;          // 필수, 최대 500자 (글자 수 합계 제외)
    string actionable_solution;   // 최대 150자
};

dictionary DebateCard {
    string id;
    StanceType stance;
    string problem_definition;
    string evidence_source;
    string evidence_url;
    string actionable_solution;
    string author_did;
    i64 created_at;               // epoch 밀리초
};

interface CardStore {
    [Throws=CardError]
    constructor(string path);

    // 카드를 추가하고 식별자를 돌려준다.
    [Throws=CardError]
    string add(DraftCard draft, string author_did, i64 created_at);

    // 최신순 목록. 브리징 점수순은 VS-F3에서.
    [Throws=CardError]
    sequence<DebateCard> list();

    [Throws=CardError]
    u32 count();
};

[Error]
interface CardError {
    Empty(string field);
    TooLong(string field, u32 limit, u32 actual);
    InvalidUrl(string reason);
    Storage(string reason);
};

[Error]
interface IdentityError {
    InvalidPublicKey();
    InvalidDid(string reason);
    InvalidSignature();
};

// 코어 빌드 식별 정보
dictionary CoreInfo {
    // 크레이트 버전 (Cargo.toml)
    string version;

    // 명세 계약 버전. 코어와 앱이 같은 명세를 구현하는지 확인한다.
    // 명세가 바뀌어 호환이 깨지면 이 값을 올린다.
    u32 spec_revision;

    // 빌드 대상 트리플 (예: aarch64-linux-android)
    string target;

    // 디버그 빌드 여부. 릴리스 앱에서 true면 배포 사고다.
    boolean debug;
};
